# Supabase Postgres — copy both from Supabase: Connect → ORM → Prisma, then add your password.
# connect_timeout=20 gives slow or distant connections time to open (Prisma's default is 5 seconds).
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=20"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-us-west-1.pooler.supabase.com:5432/postgres?connect_timeout=20"

# Twilio
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Resend
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="alerts@yourdomain.com"

# App
APP_BASE_URL="http://localhost:3000"

# Founder/internal admin login (shared secret, not per-user)
ADMIN_SECRET="change-me-to-a-long-random-string"

# Signs owner-dashboard session cookies (use: openssl rand -base64 32)
SESSION_SECRET="change-me-to-a-long-random-string"

# Set to "true" only in test runs; never in production
SKIP_TWILIO_SIGNATURE_CHECK="false"
